// ui/app-window.slint
import { LineEdit, Button } from "std-widgets.slint";
import { HomeView } from "views/home.slint";
import { SearchView } from "views/search.slint";
import { SearchStoryItem } from "views/search.slint";
import { LibraryView, LibraryStoryItem } from "views/library.slint";
import { CreateView } from "views/create.slint";
import { ProfileView } from "views/profile.slint";
import { ReaderView } from "views/reader.slint";
import { StoryDetailsView, ChapterData, StoryDetailsData } from "views/story_details.slint";
import { Palette } from "palette.slint";
import { NotificationsView } from "views/notifications.slint";

export { LibraryStoryItem }
export { SearchStoryItem }
export { ChapterData }
export { StoryDetailsData }
export { Palette }

component NavItem inherits Rectangle {
    in property <bool> is-active: false;
    in property <bool> is-dark: false;
    in property <string> label;
    in property <string> emoji;
    in property <image> icon-light;
    in property <image> icon-dark;
    property <image> current-icon: root.is-dark ? root.icon-dark : root.icon-light;
    callback clicked();

    horizontal-stretch: 1;
    height: 100%;
    background: touch.has-hover ? Palette.card-color : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        Rectangle {
            width: 24px;
            height: 3px;
            border-radius: 2px;
            background: root.is-active ? #ff500a : transparent;
            x: (parent.width - self.width) / 2;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 5px;
            if root.current-icon.width > 0 : Image {
                width: 20px;
                height: 20px;
                source: root.current-icon;
                colorize: root.is-active ? #ff500a : (root.is-dark ? #ffffff : #666666);
                image-fit: contain;
            }
            if root.current-icon.width == 0 : Text {
                text: root.emoji;
                font-size: 17px;
                vertical-alignment: center;
            }
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: root.is-active ? 700 : 500;
                color: Palette.text-color;
                vertical-alignment: center;
            }
        }
    }

}

export component AppWindow inherits Window {
    title: "Wattpad Desktop (Linux)";
    preferred-width: 1024px;
    preferred-height: 768px;
    min-width: 800px;
    min-height: 600px;
    background: Palette.bg-color;

    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> search-query: "";
    in-out property <[SearchStoryItem]> search-results: [];
    in-out property <[LibraryStoryItem]> home-stories: [];
    in-out property <[LibraryStoryItem]> library-stories: [];
    in-out property <string> draft-title: "";
    in-out property <string> draft-content: "";
    in-out property <string> draft-status-message: "";
    in-out property <bool> is-logged-in: false;
    in-out property <bool> is-loading: false;
    in-out property <bool> is-dark-mode: false;
    in-out property <bool> is-offline: false;
    in-out property <string> error-message: "";
    in-out property <string> current-username: "";
    in-out property <string> profile-full-name: "";
    in-out property <image> profile-avatar;
    in-out property <int> profile-followers: 0;
    in-out property <int> profile-following: 0;
    in-out property <int> profile-stories-count: 0;
    in-out property <string> profile-description: "";
    in-out property <int> current-tab: 0;
    in-out property <bool> is_reading: false;
    in-out property <string> reader-story-title: "";
    in-out property <string> reader-chapter-title: "";
    in-out property <int> reader-chapter-index: 0;
    in-out property <int> reader-total-chapters: 0;
    in-out property <bool> show-details: false;
    in-out property <StoryDetailsData> current-story;
    in-out property <[ChapterData]> detail-chapters: [];

    callback login-requested(string, string);
    callback search-requested(string, string);
    callback logout-requested();
    callback tab-selected(int);
    callback home-story-clicked(string);
    callback search-story-clicked(string);
    callback chapter-clicked(int);
    callback details-back-clicked();
    callback open-notifications();
    callback save-draft-requested(string, string);
    callback download-story-requested(string);
    callback read-story-requested(string);
    callback close-reader-requested();
    callback prev-chapter-requested();
    callback next-chapter-requested();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Barra superior estilo Wattpad
        Rectangle {
            height: 52px;
            background: Palette.bg-color;
            border-width: 1px;
            border-color: #eeeeee;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: "Wattpad";
                    color: Palette.text-color;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 10px;
                    if root.is-logged-in : Text {
                        text: root.is-offline ? "Sin conexión" : (root.current-username != "" ? "@" + root.current-username : "Conectado");
                        color: Palette.text-color;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Button {
                        text: root.is-dark-mode ? "☀️ Claro" : "🌙 Oscuro";
                        clicked => {
                            root.is-dark-mode = !root.is-dark-mode;
                            Palette.is-dark-mode = root.is-dark-mode;
                        }
                    }
                }
            }
        }

        // Vista de Login si no hay sesión activa
        if !root.is-logged-in : VerticalLayout {
            vertical-stretch: 1;
            padding: 24px;
            alignment: center;
            spacing: 12px;

            Text {
                text: "Inicia sesión en Wattpad";
                font-size: 20px;
                font-weight: 700;
                color: Palette.text-color;
            }

            Text {
                text: "Usa tu nombre de usuario o correo electrónico y tu contraseña.";
                font-size: 13px;
                color: Palette.text-color;
                wrap: word-wrap;
            }

            LineEdit {
                placeholder-text: "Usuario o correo electrónico";
                text <=> root.username;
                enabled: !root.is-loading;
            }

            LineEdit {
                placeholder-text: "Contraseña";
                input-type: InputType.password;
                text <=> root.password;
                enabled: !root.is-loading;
                accepted => {
                    if !root.is-loading {
                        root.login-requested(root.username, root.password);
                    }
                }
            }

            if root.error-message != "" : Rectangle {
                background: Palette.card-color;
                border-width: 1px;
                border-color: #eeeeee;
                border-radius: 6px;

                HorizontalLayout {
                    padding: 10px;
                    Text {
                        text: root.error-message;
                        color: Palette.text-color;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            Button {
                text: root.is-loading ? "Iniciando sesión..." : "Iniciar Sesión";
                primary: true;
                enabled: !root.is-loading;
                clicked => {
                    root.login-requested(root.username, root.password);
                }
            }
        }

        // Shell móvil adaptado a escritorio cuando hay sesión activa
        if root.is-logged-in : VerticalLayout {
            vertical-stretch: 1;
            padding: 0px;
            spacing: 0px;

            // Área de contenido central
            Rectangle {
                vertical-stretch: 1;
                background: Palette.bg-color;

                if root.show-details : StoryDetailsView {
                    width: 100%;
                    height: 100%;
                    story: root.current-story;
                    chapters <=> root.detail-chapters;
                    chapter-clicked(index) => { root.chapter-clicked(index); }
                    back-clicked => { root.details-back-clicked(); }
                }

                if !root.show-details && root.current-tab == 0 : HomeView {
                    width: 100%;
                    height: 100%;
                    stories <=> root.home-stories;
                    is-loading <=> root.is-loading;
                    is-offline: root.is-offline;
                    story-clicked(story-id) => {
                        root.home-story-clicked(story-id);
                    }
                }

                if !root.show-details && root.current-tab == 1 : SearchView {
                    width: 100%;
                    height: 100%;
                    search-query <=> root.search-query;
                    search-results: root.search-results;
                    is-loading <=> root.is-loading;
                    error-message: root.error-message;
                    search-requested(query, filters) => {
                        root.search-requested(query, filters);
                    }
                    story-clicked(story-id) => {
                        root.search-story-clicked(story-id);
                    }
                }

                if !root.show-details && root.current-tab == 2 : LibraryView {
                    width: 100%;
                    height: 100%;
                    stories <=> root.library-stories;
                    is-offline: root.is-offline;
                    is-loading <=> root.is-loading;
                    download-requested(story-id) => {
                        root.download-story-requested(story-id);
                    }
                    read-requested(story-id) => {
                        root.read-story-requested(story-id);
                    }
                }

                if !root.show-details && root.current-tab == 3 : CreateView {
                    width: 100%;
                    height: 100%;
                    story-title <=> root.draft-title;
                    story-content <=> root.draft-content;
                    status-message: root.draft-status-message;
                    is-saving: root.is-loading;
                    save-draft-requested(title, content) => {
                        root.save-draft-requested(title, content);
                    }
                }

                if !root.show-details && root.current-tab == 4 : ProfileView {
                    width: 100%;
                    height: 100%;
                    username <=> root.current-username;
                    full-name <=> root.profile-full-name;
                    avatar <=> root.profile-avatar;
                    followers <=> root.profile-followers;
                    following <=> root.profile-following;
                    stories-published <=> root.profile-stories-count;
                    description <=> root.profile-description;
                    is-loading: root.is-loading;
                    is-offline: root.is-offline;
                    logout-requested => {
                        root.logout-requested();
                    }
                }

                if !root.show-details && root.current-tab == 5 : NotificationsView {
                    width: 100%;
                    height: 100%;
                    open-notifications => { root.open-notifications(); }
                }
            }

            // Barra de navegación inferior (Bottom Navigation Bar)
            if !root.show-details : Rectangle {
                height: 60px;
                background: Palette.bg-color;
                border-width: 1px;
                border-color: #eeeeee;

                HorizontalLayout {
                    padding: 0px;
                    spacing: 0px;
                    alignment: center;

                    NavItem {
                        is-dark: root.is-dark-mode;
                        emoji: "🏠";
                        icon-light: @image-url("icons/house.svg");
                        icon-dark: @image-url("icons/house.svg");
                        label: "Inicio";
                        is-active: root.current-tab == 0;
                        clicked => {
                            root.tab-selected(0);
                        }
                    }

                    NavItem {
                        is-dark: root.is-dark-mode;
                        emoji: "🔔";
                        label: "Avisos";
                        is-active: root.current-tab == 5;
                        clicked => {
                            root.tab-selected(5);
                            root.open-notifications();
                        }
                    }

                    NavItem {
                        is-dark: root.is-dark-mode;
                        emoji: "🔍";
                        icon-light: @image-url("icons/search.svg");
                        icon-dark: @image-url("icons/search.svg");
                        label: "Buscar";
                        is-active: root.current-tab == 1;
                        clicked => {
                            root.tab-selected(1);
                        }
                    }

                    NavItem {
                        is-dark: root.is-dark-mode;
                        emoji: "📚";
                        icon-light: @image-url("icons/layers.svg");
                        icon-dark: @image-url("icons/layers.svg");
                        label: "Biblioteca";
                        is-active: root.current-tab == 2;
                        clicked => {
                            root.tab-selected(2);
                        }
                    }

                    NavItem {
                        is-dark: root.is-dark-mode;
                        emoji: "✍️";
                        icon-light: @image-url("icons/plus.svg");
                        icon-dark: @image-url("icons/plus.svg");
                        label: "Crear";
                        is-active: root.current-tab == 3;
                        clicked => {
                            root.tab-selected(3);
                        }
                    }

                    NavItem {
                        is-dark: root.is-dark-mode;
                        emoji: "👤";
                        icon-light: @image-url("icons/circle-user-round.svg");
                        icon-dark: @image-url("icons/circle-user-round.svg");
                        label: "Perfil";
                        is-active: root.current-tab == 4;
                        clicked => {
                            root.tab-selected(4);
                        }
                    }
                }
            }
        }
    }

    // Superposición del lector web
    if root.is_reading : ReaderView {
        width: 100%;
        height: 100%;
        story-title: root.reader-story-title;
        chapter-title: root.reader-chapter-title;
        current-chapter-index: root.reader-chapter-index;
        total-chapters: root.reader-total-chapters;
        close-requested => {
            root.close-reader-requested();
        }
        prev-chapter-requested => {
            root.prev-chapter-requested();
        }
        next-chapter-requested => {
            root.next-chapter-requested();
        }
    }
}
