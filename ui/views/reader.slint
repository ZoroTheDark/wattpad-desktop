// ui/views/reader.slint
import { Button, Spinner } from "std-widgets.slint";

export component ReaderView inherits Rectangle {
    background: #ffffff;

    in property <string> story-title: "";
    in property <string> chapter-title: "";
    in property <int> current-chapter-index: 0;
    in property <int> total-chapters: 0;

    callback close-requested();
    callback prev-chapter-requested();
    callback next-chapter-requested();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 54px;
            background: #ffffff;
            border-width: 1px;
            border-color: #eeeeee;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: space-between;

                Button {
                    text: "Volver";
                    clicked => {
                        root.close-requested();
                    }
                }

                Text {
                    text: root.story-title != "" ? root.story-title : "Lector Web";
                    font-size: 15px;
                    font-weight: 700;
                    color: #222222;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.total-chapters > 0 : Text {
                    text: (root.current-chapter-index + 1) + " / " + root.total-chapters;
                    font-size: 12px;
                    color: #666666;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 14px;
            padding: 24px;

            HorizontalLayout {
                alignment: center;

                Spinner {
                    indeterminate: true;
                    width: 36px;
                    height: 36px;
                }
            }

            Text {
                text: "Abriendo lector...";
                font-size: 16px;
                font-weight: 700;
                color: #222222;
                horizontal-alignment: center;
            }

            if root.chapter-title != "" : Text {
                text: root.chapter-title;
                font-size: 13px;
                color: #666666;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        if root.total-chapters > 1 : Rectangle {
            height: 54px;
            background: #fafafa;
            border-width: 1px;
            border-color: #eeeeee;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                Button {
                    text: "Anterior";
                    enabled: root.current-chapter-index > 0;
                    clicked => {
                        root.prev-chapter-requested();
                    }
                }

                Button {
                    text: "Siguiente";
                    primary: true;
                    enabled: root.current-chapter-index + 1 < root.total-chapters;
                    clicked => {
                        root.next-chapter-requested();
                    }
                }
            }
        }
    }
}
