import { Palette } from "../palette.slint";
// ui/views/library.slint
import { Button, ListView, Spinner } from "std-widgets.slint";

export struct LibraryStoryItem {
    id: string,
    title: string,
    author: string,
    cover: image,
    is_downloaded: bool,
}

export component LibraryView inherits Rectangle {
    background: Palette.bg-color;

    in-out property <[LibraryStoryItem]> stories: [];
    in property <bool> is-offline: false;
    in-out property <bool> is-loading: false;

    callback download-requested(string);
    callback read-requested(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Tu Biblioteca";
                font-size: 20px;
                font-weight: 700;
                color: Palette.text-color;
            }

            if root.is-offline : Text {
                text: "Modo sin conexión";
                font-size: 12px;
                color: #ff500a;
                vertical-alignment: center;
            }
        }

        if root.stories.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: Palette.card-color;
            border-width: 1px;
            border-color: #eeeeee;
            border-radius: 8px;

            VerticalLayout {
                alignment: center;
                padding: 20px;
                spacing: 6px;

                Text {
                    text: root.is-loading ? "Cargando biblioteca..." : "Tu Biblioteca (Vacía)";
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.text-color;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Las historias de tu biblioteca y listas de lectura aparecerán aquí.";
                    font-size: 13px;
                    color: Palette.text-color;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.stories.length > 0 : ListView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            for story in root.stories: Rectangle {
                height: 92px;
                border-width: 1px;
                border-color: #eeeeee;
                border-radius: 8px;
                background: Palette.card-color;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;

                    // Portada de la historia
                    Rectangle {
                        width: 48px;
                        height: 74px;
                        border-radius: 4px;
                        background: #ffe8df;
                        clip: true;

                        if story.cover.width > 0 : Image {
                            width: 100%;
                            height: 100%;
                            source: story.cover;
                            image-fit: cover;
                        }

                        if story.cover.width == 0 : Text {
                            text: "WP";
                            color: #ff500a;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: story.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: Palette.text-color;
                            overflow: elide;
                        }

                        Text {
                            text: story.author;
                            font-size: 12px;
                            color: Palette.text-color;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        Button {
                            text: story.is_downloaded ? "Actualizar" : "Descargar";
                            enabled: !root.is-loading && !root.is-offline;
                            clicked => {
                                root.download-requested(story.id);
                            }
                        }

                        Button {
                            text: "Leer";
                            primary: true;
                            enabled: story.is_downloaded && !root.is-loading;
                            clicked => {
                                root.read-requested(story.id);
                            }
                        }
                    }
                }
            }
        }
    }

    if root.is-loading : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Palette.bg-color;
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            Spinner { indeterminate: true; width: 36px; height: 36px; }
            Text { text: "Cargando..."; color: Palette.text-color; font-size: 14px; horizontal-alignment: center; }
        }
    }
}
