import { Palette } from "../palette.slint";
// ui/views/create.slint
import { LineEdit, TextEdit, Button } from "std-widgets.slint";

export component CreateView inherits Rectangle {
    background: Palette.bg-color;

    in-out property <string> story-title: "";
    in-out property <string> story-content: "";
    in property <string> status-message: "";
    in property <bool> is-saving: false;

    callback save-draft-requested(string, string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Crear Historia";
            font-size: 20px;
            font-weight: 700;
            color: Palette.text-color;
        }

        VerticalLayout {
            spacing: 4px;

            Text {
                text: "Título de la historia";
                font-size: 13px;
                font-weight: 600;
                color: Palette.text-color;
            }

            LineEdit {
                placeholder-text: "Escribe el título de tu historia...";
                text <=> root.story-title;
                enabled: !root.is-saving;
            }
        }

        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 1;

            Text {
                text: "Contenido";
                font-size: 13px;
                font-weight: 600;
                color: Palette.text-color;
            }

            TextEdit {
                vertical-stretch: 1;
                text <=> root.story-content;
                enabled: !root.is-saving;
                wrap: word-wrap;
            }
        }

        if root.status-message != "" : Rectangle {
            background: Palette.card-color;
            border-width: 1px;
            border-color: #eeeeee;
            border-radius: 6px;

            HorizontalLayout {
                padding: 10px;
                Text {
                    text: root.status-message;
                    color: Palette.text-color;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }

        Button {
            text: root.is-saving ? "Guardando..." : "Guardar Borrador";
            primary: true;
            enabled: !root.is-saving;
            clicked => {
                root.save-draft-requested(root.story-title, root.story-content);
            }
        }
    }
}
