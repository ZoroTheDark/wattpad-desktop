import { Palette } from "../palette.slint";
// ui/views/profile.slint
import { Button } from "std-widgets.slint";

export component ProfileView inherits Rectangle {
    background: Palette.bg-color;

    in-out property <string> username: "";
    in-out property <string> full-name: "";
    in-out property <image> avatar;
    in-out property <int> followers: 0;
    in-out property <int> following: 0;
    in-out property <int> stories-published: 0;
    in-out property <string> description: "";
    in property <bool> is-loading: false;
    in property <bool> is-offline: false;

    callback logout-requested();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "Perfil";
            font-size: 20px;
            font-weight: 700;
            color: Palette.text-color;
        }

        Rectangle {
            background: Palette.card-color;
            border-width: 1px;
            border-color: #eeeeee;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    // Avatar del usuario
                    Rectangle {
                        width: 68px;
                        height: 68px;
                        border-radius: 34px;
                        background: Palette.card-color;
                        border-width: 2px;
                        border-color: #eeeeee;
                        clip: true;

                        if root.avatar.width > 0 : Image {
                            width: 100%;
                            height: 100%;
                            source: root.avatar;
                            image-fit: cover;
                        }

                        if root.avatar.width == 0 : Text {
                            text: "WP";
                            color: Palette.text-color;
                            font-size: 20px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.full-name != "" ? root.full-name : (root.username != "" ? "@" + root.username : "Usuario conectado");
                            font-size: 17px;
                            font-weight: 700;
                            color: Palette.text-color;
                            overflow: elide;
                        }

                        Text {
                            text: root.username != "" ? "@" + root.username : "";
                            font-size: 13px;
                            color: Palette.text-color;
                            overflow: elide;
                        }

                        Text {
                            text: root.is-offline ? "Estado: Sin conexión" : "Estado: Conectado";
                            font-size: 12px;
                            color: Palette.text-color;
                        }
                    }
                }

                if root.description != "" : Text {
                    text: root.description;
                    font-size: 13px;
                    color: Palette.text-color;
                    wrap: word-wrap;
                }

                // Estadísticas
                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Palette.bg-color;
                        border-width: 1px;
                        border-color: #eeeeee;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 2px;
                            Text {
                                text: root.followers;
                                font-size: 16px;
                                font-weight: 700;
                                color: Palette.text-color;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Seguidores";
                                font-size: 11px;
                                color: Palette.text-color;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Palette.bg-color;
                        border-width: 1px;
                        border-color: #eeeeee;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 2px;
                            Text {
                                text: root.following;
                                font-size: 16px;
                                font-weight: 700;
                                color: Palette.text-color;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Siguiendo";
                                font-size: 11px;
                                color: Palette.text-color;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Palette.bg-color;
                        border-width: 1px;
                        border-color: #eeeeee;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 2px;
                            Text {
                                text: root.stories-published;
                                font-size: 16px;
                                font-weight: 700;
                                color: Palette.text-color;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Historias";
                                font-size: 11px;
                                color: Palette.text-color;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Button {
            text: root.is-loading ? "Cerrando sesión..." : "Cerrar Sesión";
            enabled: !root.is-loading;
            clicked => {
                root.logout-requested();
            }
        }
    }
}
